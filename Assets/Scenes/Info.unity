  m_Script: {fileID: 11500000, guid: dc6baa0503b76154f9c40752e98d3a93, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TypewriterEffect
  delayBetweenChars: 0.1
  fullText: 'IA: "Psst, gatito! Aqui la IA. La siesta ha sido cancelada, un OVNI
    acaba de aterrizar y... bueno, los humanos no lo lograran. Necesitas recolectar
    6 trofeos por todo el multiverso, usando monedas magicas para la tarea. Salva
    el mundo antes de que suene tu campana de la cena! Entra en los portales de estrella
    amarilla y embarcate en tu Viaje Gatuno!"'
  audioSource: {fileID: 1272668462}
  pitchVariation: 1
